# Munin local configuration
# Copy this file to .env and fill only the providers you use.
# Never commit the real .env file.

MUNIN_GOOGLE_CLIENT_ID=
MUNIN_GOOGLE_CLIENT_SECRET=

MUNIN_MICROSOFT_CLIENT_ID=
MUNIN_MICROSOFT_CLIENT_SECRET=

# Local inference (Ollama)
MUNIN_OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

# Optional OpenAI-compatible/Anthropic text provider. Keep blank for ChatGPT-first.
# Nemotron hosted example: https://integrate.api.nvidia.com/v1 and
# nvidia/nemotron-3-ultra-550b-a55b. Never commit a real API key.
MUNIN_LLM_BASE_URL=
MUNIN_LLM_API_KEY=
MUNIN_LLM_MODEL=
MUNIN_LLM_REASONING_MODE=off

# Runtime capability seam
MUNIN_RUNTIME_CAPABILITIES=1

# Optional external intelligence provider.
# Keep blank to use the zero-cost local fallback. The endpoint is provider-neutral
# and may be backed by GPT or another governed research/review service.
MUNIN_EXTERNAL_INTELLIGENCE_URL=
MUNIN_EXTERNAL_INTELLIGENCE_TOKEN=

# Optional local video generation. Disabled by default and never downloads model
# weights automatically. Configure an absolute executable runner that accepts one
# JSON request on stdin and returns JSON on stdout only after local/license review.
MUNIN_LOCAL_VIDEO_ENABLED=0
MUNIN_LOCAL_VIDEO_BACKEND=diffsynth
MUNIN_LOCAL_VIDEO_RUNNER=
# Token Efficiency v1 is observation-only and disabled by default.
MUNIN_TOKEN_EFFICIENCY_ENABLED=0
# Component flags default to enabled only after the top-level flag is enabled.
MUNIN_TOKEN_EFFICIENCY_TELEMETRY_ENABLED=1
MUNIN_TOKEN_EFFICIENCY_ROUTER_ENABLED=1
MUNIN_TOKEN_EFFICIENCY_BUDGET_ENABLED=1
MUNIN_TOKEN_EFFICIENCY_COMPACTION_ENABLED=1
MUNIN_TOKEN_EFFICIENCY_CHECKPOINT_ENABLED=1
MUNIN_TOKEN_EFFICIENCY_REPORT_ENABLED=1
MUNIN_TOKEN_EFFICIENCY_PROMOTION_OBSERVATION_ENABLED=1
MUNIN_TOKEN_TASK_WARNING_TOKENS=32000
MUNIN_TOKEN_TASK_CRITICAL_TOKENS=64000
MUNIN_TOKEN_SESSION_WARNING_TOKENS=128000
MUNIN_TOKEN_SESSION_CRITICAL_TOKENS=224000
MUNIN_TOKEN_FRESH_SESSION_TOKENS=272000
