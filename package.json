{
  "name": "munin-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "munin": "dist/src/cli.js",
    "provider-policy": "dist/src/provider-cli.js"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:core && npm run build:web",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "npm run build:core && node dist/src/cli.js",
    "api": "npm run build:core && node dist/src/api.js",
    "web": "vite --config apps/web/vite.config.ts",
    "workspace": "node scripts/launch.mjs",
    "provider-policy": "npm run build:core && node dist/src/provider-cli.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
