{
  "name": "munin-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "munin": "dist/src/cli.js",
    "provider-policy": "dist/src/provider-cli.js"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:core && npm run build:web",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "npm run build:core && node dist/src/cli.js",
    "serve": "npm run build:core && node dist/src/server.js",
    "api": "npm run build:core && node dist/src/api.js",
    "visual-assets-api": "npm run build:core && node dist/src/visual-assets-api.js",
    "linkedin-composer-api": "npm run build:core && node dist/src/linkedin-composer-api.js",
    "context-memory-api": "npm run build:core && node dist/src/context-memory-api.js",
    "executive-briefing-api": "npm run build:core && node dist/src/executive-briefing-api.js",
    "web": "vite --config apps/web/vite.config.ts",
    "workspace": "node scripts/launch.mjs",
    "mobile": "node scripts/launch-mobile.mjs",
    "hud": "node scripts/launch-hud.mjs",
    "hud:kiosk": "node scripts/launch-hud.mjs --kiosk",
    "hud:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-hud-startup.ps1",
    "hud:startup:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-hud-startup.ps1",
    "import:lovable": "npm run build:core && node dist/src/lovable-import-cli.js",
    "sync:email": "npm run build:core && node dist/src/email-sync-cli.js",
    "provider-policy": "npm run build:core && node dist/src/provider-cli.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
