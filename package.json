{
  "name": "munin-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "munin": "dist/src/cli.js",
    "provider-policy": "dist/src/provider-cli.js"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:core && npm run build:web",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "npm run build:core && node dist/src/cli.js",
    "serve": "npm run build:core && node dist/src/server.js",
    "api": "npm run build:core && node dist/src/api.js",
    "visual-assets-api": "npm run build:core && node dist/src/visual-assets-api.js",
    "linkedin-composer-api": "npm run build:core && node dist/src/linkedin-composer-api.js",
    "context-memory-api": "npm run build:core && node dist/src/context-memory-api.js",
    "executive-briefing-api": "npm run build:core && node dist/src/executive-briefing-api.js",
    "web": "vite --config apps/web/vite.config.ts",
    "workspace": "node scripts/launch.mjs",
    "workspace:supervisor": "node scripts/workspace-supervisor.mjs",
    "workspace:supervisor:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-workspace-supervisor-startup.ps1",
    "workspace:supervisor:startup:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-workspace-supervisor-startup.ps1",
    "mobile": "node scripts/launch-mobile.mjs",
    "mobile:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-mobile-startup.ps1",
    "mobile:startup:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-mobile-startup.ps1",
    "memory": "npm run build:core && node dist/src/memory-import-cli.js",
    "memory:sync": "npm run build:core && node dist/src/memory-sync-cli.js",
    "memory:sync:install": "powershell -ExecutionPolicy Bypass -File scripts/install-memory-sync-task.ps1",
    "knowledge:vault": "npm run build:core && node dist/src/knowledge-vault-cli.js",
    "knowledge:vault:init": "npm run knowledge:vault -- init",
    "knowledge:vault:status": "npm run knowledge:vault -- status",
    "knowledge:vault:sync": "npm run knowledge:vault -- export-context",
    "document:ingest": "npm run build:core && node dist/src/document-ingest-cli.js",
    "document:benchmark": "npm run build:core && node dist/src/document-benchmark-cli.js",
    "document:promote": "npm run build:core && node dist/src/document-promotion-cli.js",
    "browser:benchmark": "npm run build:core && node dist/src/browser-benchmark-cli.js",
    "browser:validate-local": "npm run build:core && node dist/src/browser-local-validation-cli.js",
    "browser:agent:validate": "powershell -ExecutionPolicy Bypass -File scripts/validate-agent-browser.ps1",
    "runtime:capability:benchmark": "npm run build:core && node dist/src/runtime-capability-benchmark-cli.js",
    "video:benchmark": "npm run build:core && node dist/src/local-video-benchmark-cli.js",
    "autonomy:doctor": "npm run build:core && node dist/src/autonomy-readiness-cli.js",
    "agent-security:bench": "npm run build:core && node dist/src/agent-security-bench-cli.js",
    "control-room:state": "npm run build:core && node dist/src/control-room-state-cli.js",
    "operator:sitrep": "npm run build:core && node dist/src/operator-sitrep-cli.js",
    "capability:radar": "npm run build:core && node dist/src/capability-radar-cli.js",
    "career:continuity:report": "npm run build:core && node dist/src/career-continuity-report-cli.js",
    "career:continuity:audit": "npm run build:core && node dist/src/career-continuity-audit-cli.js",
    "career:continuity:evidence": "npm run build:core && node dist/src/career-continuity-evidence-cli.js",
    "research:problem-interviews": "npm run build:core && node dist/src/problem-interviews-cli.js",
    "hud": "node scripts/launch-hud.mjs",
    "hud:kiosk": "node scripts/launch-hud.mjs --kiosk",
    "hud:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-hud-startup.ps1",
    "hud:startup:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-hud-startup.ps1",
    "import:lovable": "npm run build:core && node dist/src/lovable-import-cli.js",
    "sync:email": "npm run build:core && node dist/src/email-sync-cli.js",
    "email:intelligence": "npm run build:core && node dist/src/email-intelligence-cli.js",
    "email:worker": "npm run build:core && node dist/src/email-intelligence-worker-cli.js",
    "email:worker:once": "npm run build:core && node dist/src/email-intelligence-worker-cli.js --once",
    "email:worker:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-email-intelligence-startup.ps1",
    "provider-policy": "npm run build:core && node dist/src/provider-cli.js",
    "host:bridge": "npm run build:core && node dist/src/host-bridge-cli.js",
    "host:worker": "npm run build:core && node dist/src/host-worker-cli.js",
    "host:worker:once": "npm run build:core && node dist/src/host-worker-cli.js --once",
    "host:worker:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-host-worker-startup.ps1",
    "host:worker:startup:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-host-worker-startup.ps1",
    "manus:worker": "npm run build:core && node dist/src/manus-worker-cli.js",
    "manus:worker:once": "npm run build:core && node dist/src/manus-worker-cli.js --once",
    "manus:worker:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-manus-bridge-startup.ps1",
    "manus:worker:startup:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-manus-bridge-startup.ps1",
    "linkedin:editorial:once": "npm run build:core && node dist/src/linkedin-editorial-worker-cli.js",
    "linkedin:editorial:task:install": "powershell -ExecutionPolicy Bypass -File scripts/install-linkedin-editorial-task.ps1",
    "linkedin:editorial:task:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-linkedin-editorial-task.ps1",
    "creative:review": "npm run build:core && node dist/src/creative-studio-cli.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}