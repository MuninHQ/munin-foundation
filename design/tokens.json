{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Munin Design Tokens",
    "version": "1.0.0-observe",
    "status": "canonical-observation",
    "notes": "Tokens are a governance contract in v1. Existing screens are not automatically migrated."
  },
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#07090D" },
      "base": { "$type": "color", "$value": "#0D1117" },
      "raised": { "$type": "color", "$value": "#141A22" },
      "overlay": { "$type": "color", "$value": "#1B2430" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#F2F6FA" },
      "secondary": { "$type": "color", "$value": "#A8B3C1" },
      "muted": { "$type": "color", "$value": "#718096" },
      "inverse": { "$type": "color", "$value": "#07090D" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#202A36" },
      "strong": { "$type": "color", "$value": "#364456" }
    },
    "semantic": {
      "intelligence": { "$type": "color", "$value": "#3B82F6" },
      "healthy": { "$type": "color", "$value": "#22C55E" },
      "attention": { "$type": "color", "$value": "#F59E0B" },
      "critical": { "$type": "color", "$value": "#EF4444" },
      "neutral": { "$type": "color", "$value": "#718096" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "borderWidth": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "strong": { "$type": "dimension", "$value": "2px" }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "24px" },
      "2xl": { "$type": "dimension", "$value": "32px" }
    },
    "weight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold": { "$type": "number", "$value": 700 }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "normal": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },
  "shadow": {
    "subtle": { "$type": "shadow", "$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" } }
  }
}
